# 이 파일을 .env.local로 복사한 뒤 본인 계정의 값으로 채우세요. (.env.local은 git에 올라가지 않습니다)
#   cp .env.example .env.local

# 데이터 모드: 'false'일 때만 실데이터 모드(Pinecone + Supabase + Gemini), 그 외에는 Mock 모드
# Mock 모드는 samples/review.csv와 서버 메모리만 사용하며 외부 API를 호출하지 않습니다.
USE_MOCK=true

# ---- 이하 실데이터 모드(USE_MOCK=false)에서만 필요 ----

# Gemini (답변 생성)
GEMINI_API_KEY=

# Pinecone 통합 임베딩 인덱스 (llama-text-embed-v2, 1024 dim, cosine)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_HOST=

# Supabase (supabase/sql/001_reviews_messages.sql을 SQL Editor에서 먼저 실행)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
# 레거시 anon 키를 쓰는 프로젝트라면 위 대신 사용
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
